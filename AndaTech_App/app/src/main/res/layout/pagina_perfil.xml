<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071134"
    android:padding="24dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#071134"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" >

        <ImageView
            android:id="@+id/logo"
            android:layout_width="110dp"
            android:layout_height="35dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_blanco" />

    </androidx.appcompat.widget.Toolbar>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginStart="9dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:text="Cerrar sesión"
        style="@style/AppButton"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCambiarContrasena" />

    <TextView
        android:id="@+id/perfilTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="Mi perfil"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <TextView
        android:id="@+id/perfilNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nombre"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="@+id/perfilTitulo"
        app:layout_constraintTop_toBottomOf="@+id/perfilTitulo" />

    <TextView
        android:id="@+id/perfilCorreo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Correo"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="@+id/perfilNombre"
        app:layout_constraintTop_toBottomOf="@+id/perfilNombre" />

    <TextView
        android:id="@+id/perfilTelefono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Teléfono"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="@+id/perfilCorreo"
        app:layout_constraintTop_toBottomOf="@+id/perfilCorreo" />

    <TextView
        android:id="@+id/tvCambiarContrasena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Cambiar contraseña"
        android:textColor="#64B5F6"
        app:layout_constraintStart_toStartOf="@+id/perfilTelefono"
        app:layout_constraintTop_toBottomOf="@+id/perfilTelefono" />

    <ImageView
        android:id="@+id/perfilFoto"
        android:layout_width="64dp"
        android:layout_height="47dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:srcCompat="@drawable/ic_perfil_blanco" />

    <ImageView
        android:id="@+id/editNombre"
        android:layout_width="18dp"
        android:layout_height="19dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/perfilNombre"
        app:layout_constraintStart_toEndOf="@+id/perfilNombre"
        app:layout_constraintTop_toTopOf="@+id/perfilNombre"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/ic_perfil_blanco" />

    <ImageView
        android:id="@+id/editCorreo"
        android:layout_width="18dp"
        android:layout_height="19dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/perfilCorreo"
        app:layout_constraintStart_toEndOf="@+id/perfilCorreo"
        app:layout_constraintTop_toTopOf="@+id/perfilCorreo"
        app:srcCompat="@drawable/ic_perfil_blanco" />

    <ImageView
        android:id="@+id/editTelefono"
        android:layout_width="18dp"
        android:layout_height="19dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/perfilTelefono"
        app:layout_constraintStart_toEndOf="@+id/perfilTelefono"
        app:layout_constraintTop_toTopOf="@+id/perfilTelefono"
        app:srcCompat="@drawable/ic_perfil_blanco" />

</androidx.constraintlayout.widget.ConstraintLayout>