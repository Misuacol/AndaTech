<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#14234A"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/alertaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posible caída detectada"
            android:textColor="#FF7777"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertaDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Se ha registrado una posible caída."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/alertaFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="19:45"
            android:textColor="#AAB6D3"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>