<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071134"
    android:paddingTop="20dp">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#071134"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="110dp"
            android:layout_height="35dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_blanco" />

    </androidx.appcompat.widget.Toolbar>

    <!-- CONTENIDO DESLIZABLE -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="24dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ÚNICO HIJO DEL SCROLLVIEW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TEXTO INTRODUCTORIO -->
            <TextView
                android:id="@+id/textHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Transformamos el andador tradicional en un compañero inteligente que protege cada paso, previene accidentes y conecta a las familias con sus mayores en tiempo real."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <!-- DESCRIPCIÓN -->
            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="El sistema va dirigido tanto a personas mayores o con movilidad reducida que desean mantener una vida activa y segura, como a familiares, cuidadores profesionales y centros geriátricos que buscan supervisar su bienestar sin invadir su intimidad. Por su enfoque asistencial y preventivo, nuestra aplicación se enmarca dentro de las categorías de "
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- SECCIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- EL PROBLEMA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="El problema"
                    android:textColor="#A78BFA"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="El envejecimiento de la población y la pérdida progresiva de movilidad plantean un reto diario para millones de personas mayores y sus familias. Mientras que los usuarios de andadores buscan conservar su independencia tanto dentro de casa como en sus paseos cotidianos, sus familiares y cuidadores conviven con la preocupación constante de que sufran una caída, se desorienten en la calle o tengan una emergencia sin nadie cerca para auxiliarlos. Los andadores convencionales ofrecen apoyo mecánico, pero carecen de mecanismos de prevención activa, comunicación o monitorización."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <!-- ESPACIO -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />

                <!-- NUESTRA SOLUCIÓN -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Nuestra solución"
                    android:textColor="#A78BFA"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="Nuestro proyecto consiste en un sistema asistido inteligente acoplable a andadores, compuesto por un módulo hardware basado en M5Stack y un conjunto de sensores y actuadores de sencilla instalación, sincronizado en tiempo real con una aplicación móvil para Android. Su objetivo es dotar al andador de capacidades inteligentes para prevenir accidentes, asistir al usuario en su entorno y mantener informados en todo momento a sus familiares o cuidadores."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
