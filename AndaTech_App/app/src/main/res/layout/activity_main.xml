<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAndadores"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/tarjeta_andador" >

    </androidx.recyclerview.widget.RecyclerView>

            <TextView
                android:id="@+id/menu_andadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="ANDADORES"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_recordatorios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="RECORDATORIOS"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menu_acerca_de"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="enviarAcercaDe"
                android:padding="8dp"
                android:text="ACERCA DE"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <ImageView
        android:id="@+id/menu_perfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/horizontalScrollView"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/horizontalScrollView"
        app:srcCompat="@drawable/baseline_account_circle_24" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAndadores"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            layout="@layout/componente_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>